# Copy this file to .env.properties (gitignored) and fill in real values.
# Only needed when running with the "local" Spring profile.

# Supabase → Project Settings → Database → Connection string → "URI" (use the
# direct connection on port 5432, not the pooler, for a long-lived backend).
# Append ?sslmode=require — Supabase requires SSL on direct connections.
DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=
